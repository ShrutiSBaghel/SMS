# Backend runtime settings. Enter real secrets in the Vercel backend project.
SPRING_PROFILES_ACTIVE=prod
PORT=8080
# Supabase Connect > Session pooler > JDBC, with credentials provided separately.
SUPABASE_DB_URL=jdbc:postgresql://YOUR-SESSION-POOLER-HOST:5432/postgres?sslmode=require
SUPABASE_DB_USERNAME=postgres.YOUR-PROJECT-REF
SUPABASE_DB_PASSWORD=REPLACE_IN_VERCEL
JWT_SECRET=REPLACE_WITH_BASE64_RANDOM_KEY_OF_AT_LEAST_32_BYTES
# Exact frontend origins separated by commas; no paths or trailing slashes.
CORS_ALLOWED_ORIGINS=https://YOUR-FRONTEND-PROJECT.vercel.app
# Per container instance; keep small and budget for autoscaling.
DB_POOL_MAX_SIZE=3
